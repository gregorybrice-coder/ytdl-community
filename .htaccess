# Empêche l'accès direct aux dépendances Composer (code source PHP tiers
# téléchargeable, métadonnées de versions) et au manifeste — rien de secret
# dedans (les vraies clés vivent dans lib.php, hors du dossier public via
# ytdl-data pour la base/cookies), mais aucune raison de les exposer.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/ytdl/vendor(/|$)
</IfModule>
<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Manifeste, icônes et service worker : toujours revalidés auprès du
# serveur. Sans en-tête, Chrome les gardait en cache plusieurs jours (le
# manifeste n'ayant pas changé depuis longtemps) et réinstallait l'appli
# avec l'ancienne icône.
<IfModule mod_headers.c>
    <FilesMatch "^(manifest\.json|icon-[0-9]+\.png|service-worker\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# La configuration et les outils ne sont jamais servis au navigateur.
<FilesMatch "^(config(?:\.local)?|db|lib|auth|mailer|import-lib|import-worker|download-start|library-access-lib)\.php$|^\.">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/ytdl/(scripts|tests|config-examples|\.git|\.github|vendor)(/|$)
</IfModule>

# Durcissement : le dépôt .git, les fichiers cachés, les journaux, la documentation,
# les scripts et les dépendances ne sont jamais servis. [NC] : certains disques
# (macOS, Windows) ignorent la casse des noms de fichiers.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^vendor(/|$) - [F,L,NC]
    RewriteRule \.(log|md|sh|txt|lock|sql|db|sqlite3?|bak[0-9]*|backup|old|orig|swp|ini|py|pem|key|zip|tar|gz)$ - [F,L,NC]
    RewriteRule (^|/)[^/]+\.avant_[^/]*$ - [F,L,NC]
    # Scripts en ligne de commande uniquement (migrations, vérifications)
    RewriteRule ^(migrate-[^/]*|dedupe-check)\.php$ - [F,L,NC]
</IfModule>
<FilesMatch "(?i)^(\..*|.*\.(log|md|sh|lock|sql|db|pem|key|zip)|migrate-.*\.php|dedupe-check\.php)$">
    Require all denied
</FilesMatch>
